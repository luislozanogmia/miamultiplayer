# Mia Multiplayer — environment configuration
# Copy this file to .env and fill in your own values.

# OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: Anthropic API key for direct Claude access
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Mia Router provision (Lambda endpoint for per-user key minting)
MIA_ROUTER_PROVISION_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws/
MIA_ROUTER_PROVISION_TOKEN=your-provision-token-here

# Model allowlist for managed routing (comma-separated OpenRouter model IDs)
# When set, only these models appear in the picker for OpenRouter users.
# Leave empty to show all available models.
# MIA_ROUTER_MODEL_ALLOWLIST=deepseek/deepseek-v4.1-flash
