# Mia Multiplayer — environment configuration
# Copy this file to .env and fill in your own values.

# OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: Anthropic API key for direct Claude access
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Mia Router provision (Lambda endpoint for per-user key minting)
MIA_ROUTER_PROVISION_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws/
MIA_ROUTER_PROVISION_TOKEN=your-provision-token-here
