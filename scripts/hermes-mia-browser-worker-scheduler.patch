@@ -150,6 +275,8 @@ def _batch_admission(tool_call, execution_cwd: Optional[Path]) -> tuple[str, Lis
         logging.debug("Non-dict args for %s (%s) — treating as sequential barrier", tool_name, type(function_args).__name__)
         return None

+    if tool_name == "mia_browser_work":
+        return (tool_name, [], False) if _mia_worker_batch_admitted(function_args) else None
     name, args = _peel_bridge_call(tool_name, function_args)
     if name in _NEVER_PARALLEL_TOOLS:
         return None
