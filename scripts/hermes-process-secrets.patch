--- /dev/null
+++ b/hermes_cli/mia_process_secrets.py
@@ -0,0 +1,41 @@
+"""Mia-owned broker credentials received after process creation, never in env/config."""
+import json
+import os
+import re
+import sys
+
+_values = {}
+
+
+def load():
+    if os.environ.pop("MIAOS_PROCESS_SECRETS_STDIN", "") != "1":
+        return
+    raw = sys.stdin.buffer.readline(4097)
+    if not raw or len(raw) > 4096 or sys.stdin.buffer.read(1):
+        raise RuntimeError("Invalid Mia process secret payload")
+    try:
+        values = json.loads(raw)
+        expected = {"MIA_GOOGLE_BROKER_URL", "MIA_GOOGLE_BROKER_RUN_TOKEN",
+                    "MIA_GOOGLE_MCP_SERVER", "MIA_GOOGLE_MCP_PYTHON"}
+        if not isinstance(values, dict) or set(values) != expected:
+            raise ValueError()
+        if not all(isinstance(value, str) and value for value in values.values()):
+            raise ValueError()
+        if not re.fullmatch(r"http://127\.0\.0\.1:\d+", values["MIA_GOOGLE_BROKER_URL"]):
+            raise ValueError()
+        if not re.fullmatch(r"[A-Za-z0-9_-]{43}", values["MIA_GOOGLE_BROKER_RUN_TOKEN"]):
+            raise ValueError()
+        if not all(os.path.isabs(values[name]) for name in ("MIA_GOOGLE_MCP_SERVER", "MIA_GOOGLE_MCP_PYTHON")):
+            raise ValueError()
+    except (TypeError, ValueError):
+        raise RuntimeError("Invalid Mia process secret payload") from None
+    _values.update(values)
+
+
+def bootstrap_for(command, args):
+    if not _values or not isinstance(args, (list, tuple)) or len(args) != 1:
+        return None
+    same = lambda a, b: os.path.normcase(os.path.realpath(a)) == os.path.normcase(os.path.realpath(b))
+    if not same(command, _values["MIA_GOOGLE_MCP_PYTHON"]) or not same(args[0], _values["MIA_GOOGLE_MCP_SERVER"]):
+        return None
+    return {"url": _values["MIA_GOOGLE_BROKER_URL"], "token": _values["MIA_GOOGLE_BROKER_RUN_TOKEN"]}
