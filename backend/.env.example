MIAOS_PUBLIC_BASE_URL=https://app.example.com

# Keep normal Mia chat user-facing: only final answers reach the conversation store.
# Set MIAOS_EXTERNAL_CHAT=0 only for explicitly local/internal debugging.
MIAOS_EXTERNAL_CHAT=1
MIAOS_DEBUG_HOOKS=0

# Internet-facing single-user release. Only this exact users-table identity
# may authenticate with a cookie or API key. On an empty database, its first
# successful INSTANCE_PASSWORD login creates the durable admin row.
# Uncomment the whole block together: single-user mode needs the bootstrap
# password (there is no default — the server accepts no logins without it)
# and REQUIRES every storage path below as an absolute path outside the
# source tree; startup fails if any is missing.
# MIAOS_SINGLE_USER_EMAIL=owner@example.com
# INSTANCE_PASSWORD=replace-with-a-strong-bootstrap-password
# DB_PATH=/absolute/path/to/mia-os.db
# DATA_DIR=/absolute/path/to/data
# MIAOS_ARTIFACT_DIR=/absolute/path/to/workspace-artifacts
# MIAOS_ATTACHMENT_DIR=/absolute/path/to/conversation-attachments
MIAOS_BIND_HOST=127.0.0.1

# Hosted-safe Mia profile: web_search/web_extract only, with no model-directed
# host files, terminal, memory, prior-session search, or browser automation.
MIAOS_AGENT_SEARCH_ONLY=1

# Mia-hosted web search. Every installed client calls the hosted gateway with
# an app-issued installation credential; end users do not supply Firecrawl or
# 1Password credentials. Keep the real token only in the installation runtime.
MIAOS_FIRECRAWL_GATEWAY_URL=https://search.os.example.com
MIAOS_FIRECRAWL_GATEWAY_TOKEN=replace-with-installation-service-token

# Immutable local artifact bytes. Metadata and authoritative workspace
# membership stay in DB_PATH; only server-derived blob paths live here.
# Set these to absolute paths outside the source tree in a release deployment.
# MIAOS_ARTIFACT_DIR=
# MIAOS_ATTACHMENT_DIR=

# The Hermes/gws CLI has one process-scoped Google profile. Bind it to one
# authenticated Mia user; other users receive no Google data or operations.
MIAOS_GOOGLE_ACCOUNT_OWNER=owner@example.com

# Image-bearing turns use the separately authenticated xAI OAuth provider and
# a verified multimodal model. Text-only inference keeps its existing route.
MIAOS_VISION_PROVIDER=xai-oauth
MIAOS_VISION_MODEL=grok-4.3

# Hermes owns provider credentials. Mia passes these provider-specific model
# defaults when a user selects a harness provider; override only if the
# deployed Hermes catalog uses different model names.
# MIAOS_HERMES_OPENAI_MODEL=gpt-5.5
# MIAOS_HERMES_XAI_MODEL=grok-4.6

# Google Workspace development connector (Gmail, Drive, Sheets, and Docs via
# one Google OAuth Authorization Code flow).
# Keep the real client secret and 32-byte encryption/state secrets in the
# ignored runtime environment only; never commit a populated .env file.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4870/api/connections/google/callback
GOOGLE_FRONTEND_URL=http://127.0.0.1:4930
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret

# Hosted auth via Clerk (https://clerk.com). ON by default, pointed at Mia's
# own instance (public identifiers built into backend/server.js) so signing
# in joins the Mia ecosystem — or skip sign-in and use your own provider
# keys. To opt out entirely set MIAOS_CLERK_AUTH=0 (or MIAOS_NO_AUTH=1 for a
# local no-auth profile). To point a fork at your own Clerk instance,
# override all three values below (public identifiers, never secrets).
# MIAOS_CLERK_AUTH=0
# CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...your Clerk JWKS public key...\n-----END PUBLIC KEY-----"

# The Mia Router (managed provider). The endpoint default is built into
# backend/server.js; a signed-in user's session token is the only
# authorization it accepts. Override to point at your own service, or set
# the URL to an empty value to hide the provider.
# MIAOS_MANAGED_ROUTER_URL=
# MIAOS_MANAGED_ROUTER_LABEL=Mia Router
# MIAOS_MANAGED_ROUTER_MODEL_ALLOWLIST=deepseek/deepseek-v4.1-flash
