#!/usr/bin/env bash
set -euo pipefail

# Public-repo guard: blocks secrets and server-side code from ever being
# committed. Everything in this repo is public; real secrets live only in
# 1Password and the deployment environment (AWS), and server-side service
# code (minting, budgets) lives only in AWS — never here.
# Installed via: git config core.hooksPath .githooks

STAGED_FILES=$(git diff --staged --name-only --diff-filter=ACMR)
[[ -z "$STAGED_FILES" ]] && exit 0

fail() { echo "COMMIT BLOCKED: $1" >&2; exit 1; }

# 1. Env files and server-side service code must never be committed, even
# force-added. The repo contains only client calls to hosted services.
while IFS= read -r f; do
  case "$f" in
    .env|*/.env|.env.local|backend/.env.local)
      fail "'$f' is a local env file and must not be committed." ;;
    ops/*)
      fail "'$f' looks like server-side service code; that lives only in AWS, never in this repo." ;;
  esac
done <<< "$STAGED_FILES"

# 3. Common credential shapes in added lines (skip the leak-scanner test file,
# whose fixtures are deliberately fake).
DIFF_NO_FIXTURES=$(git diff --staged --unified=0 -- . ':(exclude)macos/scripts/package-mac.test.cjs' ':(exclude).githooks/pre-commit')
# Mia's own production Clerk *publishable* key is a public identifier that
# ships in the client (CLAUDE.md, rule 3). Human-approved against the Clerk
# dashboard; allow exactly this value, every other pk_live_ stays blocked.
MIA_CLERK_PK_LIVE='pk_live_Y2xlcmsubWlhbXVsdGlwbGF5ZXIuY29tJA=='
DIFF_NO_FIXTURES=${DIFF_NO_FIXTURES//"$MIA_CLERK_PK_LIVE"/}
if grep -qE '^\+.*(sk-[A-Za-z0-9]{20,}|sk_live_|pk_live_|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY)' <<< "$DIFF_NO_FIXTURES"; then
  fail "staged changes contain what looks like a credential/private key."
fi

# 4. gitleaks, if installed (deeper scan).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || fail "gitleaks found a potential secret in staged changes."
fi

exit 0
